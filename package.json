{
  "name": "toondao",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first BYOK chat client where context assembly is a first-class per-node policy, decoupled from tree position.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -p tsconfig.app.json --noEmit",
    "dev:mock": "node dev/mock-llm.mjs",
    "check:models": "node dev/check-models.mjs",
    "bridge": "node bridge/index.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
